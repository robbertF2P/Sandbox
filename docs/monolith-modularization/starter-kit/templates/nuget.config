<?xml version="1.0" encoding="utf-8"?>
<!--
  Floorganise platform feed — copy to monolith repo root as nuget.config.
  1. Replace FLOORORGANISE_ARTIFACTS_FEED_URL with Artifacts → Connect to feed → dotnet (v3 index.json).
  2. Extend packageSourceMapping patterns when new internal package IDs are introduced.
  3. Never add packageSourceCredentials or PATs to this file.
  See: docs/monolith-modularization/platform-nuget-feed-standard.md
-->
<configuration>
  <packageSources>
    <clear />
    <add key="floorganise-platform" value="FLOORORGANISE_ARTIFACTS_FEED_URL" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="floorganise-platform">
      <package pattern="Platform.Serilog.Logging" />
      <package pattern="Platform.Serilog.Logging.*" />
      <package pattern="ImportPipeline.*" />
      <!-- Add Floorganise.* or bounded-context prefixes as packages ship -->
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
